      "source": [
        "def collatz(n): #define the function\n",
        "  if n%2==0: #number is even\n",
        "    output=n//2\n",
        "  else: #number is odd\n",
        "    output=n*3+1\n",
        "  print(output,end=' ')\n",
        "  return output\n",
        "n=int(input('number')) #get input\n",
        "print(n,end=' ')\n",
        "while n!=1: #function until result equals to 1\n",
        "  n=collatz(n)"
